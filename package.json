    "@file-viewer/renderer-word": "3.3.6",
    "kmgr-api": "file:./plugin-sdk/kmgr-api-0.1.0.tgz",
    "plugin-protocol": "file:./plugin-sdk/plugin-protocol-0.1.0.tgz",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "esbuild": "^0.21.0",
